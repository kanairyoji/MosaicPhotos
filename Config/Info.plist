<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- BGProcessingTask（スクリーンロック中の重い処理）用の部分 plist。
	     GENERATE_INFOPLIST_FILE=YES と併用され、生成キー（INFOPLIST_KEY_*）とマージされる。
	     配列キーは INFOPLIST_KEY_ ビルド設定で表現できないためここに置く。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.kanai.MosaicPhotos.heavywork</string>
		<!-- 解析セッション（BGContinuedProcessingTask・ADR-182）: 利用者が始めた解析を
		     アプリを閉じても続ける。登録はタップ時（起動時登録は不要）。 -->
		<string>com.kanai.MosaicPhotos.analyze</string>
	</array>
</dict>
</plist>
