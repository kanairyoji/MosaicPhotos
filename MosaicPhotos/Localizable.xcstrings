    "Choose the person to group “%@” with as the same person (e.g. a child across ages). Their photos will appear together. You can separate them later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」と同じ人物（例: 成長した子供）として束ねる相手を選びます。写真はまとめて表示され、後で解除できます。"
          }
        }
      }
    },
    "Choose the person to merge “%@” into. All their photos will move to that person.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の統合先の人物を選びます。この人物の写真はすべて統合先へ移ります。"
          }
        }
      }
    },
