{
  "sourceLanguage": "en",
  "strings": {
    "“%@” and “%@” will be shown as the same person. You can separate them later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」と「%@」は同じ人物として表示されます。後で解除できます。"
          }
        }
      }
    },
    "“%@” will be merged into “%@”. This can’t be undone automatically.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を「%2$@」に統合します。自動では元に戻せません。"
          }
        }
      }
    },
    "“Analyze Now” starts immediately for 30 minutes — your iPhone must be charging. Otherwise analysis runs automatically based on Processing Timing (by default while charging, on Wi-Fi, and not in use).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今すぐ解析」を押すと 30 分間すぐに実行します（iPhone の充電が必要です）。それ以外は「処理のタイミング」の設定に従って自動で進みます（既定では、充電中・Wi-Fi・未使用のとき）。"
          }
        }
      }
    },
    "%.1fs pause": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f秒休止"
          }
        }
      }
    },
    "%@ — %lld/batch · %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$lld枚/回 · %3$@"
          }
        }
      }
    },
    "%@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@"
          }
        }
      }
    },
