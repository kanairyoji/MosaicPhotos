            "value": "この人ではない顔をタップしてください。「この人ではない」を選ぶと相手を選ばず外せます。正しい人物を選んでもかまいません。"
          }
        }
      }
    },
    "Tap to add — from your library": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで追加 — あなたのライブラリから"
          }
        }
      }
    },
    "Template": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレート"
          }
        }
      }
    },
    "Text tokenizer vocabulary (bpe_simple_vocab_16e6.txt)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストトークナイザの語彙（bpe_simple_vocab_16e6.txt）"
          }
        }
      }
    },
    "Thanks! %lld answers recorded.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。%lld 件の回答を記録しました。"
          }
        }
      }
    },
    "The app applies what it learned during the next overnight analysis.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習した内容は次の夜間解析で反映されます。"
          }
        }
      }
    },
    "The app is analyzing your photos in the background right now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまバックグラウンドで写真を解析しています。"
          }
        }
      }
    },
    "Third-party assets distributed with the app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに同梱される第三者の資産。"
          }
        }
      }
    },
    "This app": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリ"
          }
        }
      }
    },
    "This application": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリケーション"
          }
