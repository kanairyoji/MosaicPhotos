    "VLM（写真の説明文）": {},
    "When to process": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつ処理するか"
          }
        }
      }
    },
    "While charging": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電中のみ"
          }
        }
      }
    },
    "Wi-Fi only": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi のみ"
          }
        }
      }
    },
    "Wi-Fi, skip Low Data": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi（低データモードは除く）"
          }
        }
      }
    },
    "Worked example": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "具体例"
          }
        }
      }
    },
    "Yes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい"
          }
        }
      }
    },
    "You'll see a quick preview right away. The album is then fully analyzed and refined while your iPhone is locked, charging, and connected to Wi-Fi (typically overnight) — results improve automatically as photos are indexed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成するとすぐに簡易プレビューが表示されます。その後、iPhone がロックされ、電源と Wi-Fi に接続されている間（主に夜間）に AI が本格的な解析を行い、写真のインデックスが進むにつれて自動で精度が上がっていきます。"
          }
        }
      }
    },
    "Your answers teach the app — recognition improves as you review.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答はアプリの学習に使われます。確認するほど認識が良くなります。"
          }
        }
      }
    },
