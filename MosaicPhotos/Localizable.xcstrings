          "stringUnit": {
            "state": "translated",
            "value": "モデルのビルド/変換にのみ使用。アプリには同梱されません。"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン"
          }
        }
      }
    },
    "Very coarse (~10 km)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とても粗い（約10km）"
          }
        }
      }
    },
    "Very Gentle": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とても控えめ"
          }
        }
      }
