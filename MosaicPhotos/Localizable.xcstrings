    "Albums appear in the “Albums” section on the home screen. They are built from Dropbox photos only, so connect Dropbox and load Cloud first. Runs in the background — regenerate after changing rules.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムはホーム画面の「アルバム」セクションに表示されます。Dropbox の写真のみから作成されるため、先に Dropbox に接続してクラウドを読み込んでください。バックグラウンドで実行されます。ルール変更後は再生成してください。"
          }
        }
      }
    },
    "All Photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての写真"
          }
        }
      }
    },
    "Also on battery (Wi-Fi)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーでも（Wi-Fi）"
          }
        }
      }
    },
    "Also while using the app (charging)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ使用中も（充電時）"
          }
        }
      }
    },
    "Always": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に"
          }
        }
      }
    },
    "an optional part that isn't captured": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の部分（キャプチャしない）"
          }
        }
      }
    },
    "Analysis is not running right now. It resumes automatically under the conditions you set in Processing Timing, or tap “Analyze Now” below.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在は解析していません。「処理のタイミング」で設定した条件になると自動で再開します。下の「今すぐ解析」ですぐ始めることもできます。"
          }
        }
      }
    },
    "Analyze Now (while charging)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ解析（充電中）"
          }
        }
