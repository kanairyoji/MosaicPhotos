          }
        }
      }
    },
    "Used only by the design-note site, not in the app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設計資料サイトでのみ使用（アプリには非同梱）。"
          }
        }
      }
    },
    "Used only to build/convert the model. Not distributed in the app.": {
      "localizations": {
