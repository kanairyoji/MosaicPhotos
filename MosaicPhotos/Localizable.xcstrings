    "100 km": {},
    "A one-sentence description generated on device, for your favorite photos only (it's the heaviest pass). Mark photos as favorites to have them described.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内で生成する一文の説明です。もっとも重い処理のため、お気に入りの写真だけに付けます。説明が欲しい写真はお気に入りにしてください。"
          }
        }
      }
    },
    "Add Rule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールを追加"
          }
        }
      }
    },
    "Additionally runs between your interactions while the app is open (charging + Wi-Fi). Stops the instant you touch the screen; slight warmth possible.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "加えて、アプリを開いている間も操作の合間に実行します（充電＋Wi-Fi 時）。画面に触れた瞬間に停止します。端末が少し温かくなることがあります。"
          }
        }
      }
    },
    "Additionally runs on battery (Wi-Fi, above 20% charge, Low Power Mode off). Uses battery.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "加えて、バッテリー駆動でも実行します（Wi-Fi・残量20%以上・低電力モードOFF時）。バッテリーを消費します。"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細"
          }
        }
      }
    },
