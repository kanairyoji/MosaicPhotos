      }
    },
    "Full image limit" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フル画像上限"
          }
        }
      }
    },
    "How many thumbnail batches Dropbox fetches at once (%lld–%lld). Higher is faster when many thumbnails are visible, but too high may hit Dropbox rate limits. Default is %lld." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropbox がサムネイルを同時に取得するバッチ数（%1$lld〜%2$lld）。多いほど大量のサムネイル表示が速くなりますが、多すぎると Dropbox のレート制限にかかることがあります。既定は %3$lld。"
          }
        }
      }
    },
    "JPEG 品質（サムネ/フル）" : {
      "comment" : "A label for the JPEG quality of thumbnails and full images.",
      "isCommentAutoGenerated" : true
    },
    "list_folder の 1 ページ上限" : {
      "comment" : "The maximum number of items returned by Dropbox's list_folder API.",
      "isCommentAutoGenerated" : true
    },
    "longpoll のタイムアウト" : {
      "comment" : "The timeout for longpoll requests.",
      "isCommentAutoGenerated" : true
    },
    "Not connected" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未接続"
          }
        }
      }
    },
    "Only photos under this folder are shown and indexed. Default “/” covers your whole Dropbox. Your backup folder is always included. Changing the folder clears the cached listing and rescans." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダ以下の写真だけを表示・解析します。既定の「/」は Dropbox 全体が対象です。バックアップフォルダは常に含まれます。変更すると一覧キャッシュを破棄して再スキャンします。"
          }
        }
      }
    },
    "Parallel downloads" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "並列ダウンロード数"
          }
        }
