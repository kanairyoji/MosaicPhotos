{
  "sourceLanguage": "en",
  "strings": {
    "%d failed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗 %d"
          }
        }
      }
    },
    "%d folders": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d フォルダ"
          }
        }
      }
    },
    "%d photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 枚"
          }
        }
      }
    },
    "%d photos remaining — runs automatically at night (charging, Wi-Fi)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り %d 枚 — 夜間（充電＋Wi-Fi 時）に自動で進みます"
          }
        }
      }
    },
    "%d sets": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d セット"
          }
        }
      }
    },
    "%d shared": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有済み %d"
          }
        }
      }
    },
    "%d waiting for backup": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ待ち %d"
          }
        }
      }
    },
    "%lld": {
      "comment": "A number.",
      "isCommentAutoGenerated": true
    },
    "%lld GB": {
      "comment": "1024 以上の場合は「GB」、それ以外は「MB」",
      "isCommentAutoGenerated": true
    },
    "%lld MB": {
      "comment": "1024 以上の場合は「GB」、それ以外は「MB」",
      "isCommentAutoGenerated": true
    },
    "%lld uploaded · %lld already backed up": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld枚アップロード · %2$lld枚はバックアップ済み"
          }
        }
      }
    },
    "(waiting for backup)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（バックアップ待ち）"
          }
        }
      }
    },
    "10": {
      "comment": "A label for a 10-photo upload limit.",
      "isCommentAutoGenerated": true
    },
    "100": {
      "comment": "A label for a 100-photo upload limit.",
      "isCommentAutoGenerated": true
    },
    "50": {
      "comment": "A label for a 50-photo option in the backup limit picker.",
      "isCommentAutoGenerated": true
    },
    "500": {
      "comment": "A label for a 500-photo-limit option.",
      "isCommentAutoGenerated": true
    },
    "Add": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "Add folder path (e.g. /MosaicShare)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダパスを追加（例: /MosaicShare）"
          }
        }
      }
    },
    "All photos are backed up.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての写真がバックアップ済みです。"
          }
        }
      }
    },
    "Auto offload": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動オフロード"
          }
        }
      }
    },
    "Auto offload is not available yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動オフロードはまだ利用できません"
          }
        }
      }
    },
    "Automatic offloading is not implemented yet. The setting has been reset to “Don't offload”.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動オフロードは未実装です。設定を「オフロードしない」に戻しました。"
          }
        }
      }
    },
    "Back Up Now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐバックアップ"
          }
        }
      }
    },
    "Backed up": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ済み"
          }
        }
      }
    },
    "Backup": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ"
          }
        }
      }
    },
    "Backup Destination": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ先"
          }
        }
      }
    },
    "Backup cancelled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを中止しました。"
          }
        }
      }
    },
    "Cancel Backup": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを中止"
          }
        }
      }
    },
    "Check candidates (nothing is deleted)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補を確認（何も削除されません）"
          }
        }
      }
    },
    "Checking status…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状況を確認中…"
          }
        }
      }
    },
    "Cloud Sharing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド共有"
          }
        }
      }
    },
    "Copy selected photos into a shared folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ写真を共有フォルダへコピーする"
          }
        }
      }
    },
    "Could not check the shared folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダを確認できませんでした。"
          }
        }
      }
    },
    "Could not prepare the shared folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダを準備できませんでした。"
          }
        }
      }
    },
    "Could not remove the shared folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダを削除できませんでした。"
          }
        }
      }
    },
    "Create shared sets from albums, people, and groups. Device photos need Backup to be shared (cloud photos don't). Receiving is not affected by this switch.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバム・人物・グループから共有セットを作成します。端末写真の共有にはバックアップが必要です（クラウド写真は不要）。このスイッチは「受け取る」機能には影響しません。"
          }
        }
      }
    },
    "Delete %d photo(s) from this device": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 枚をこの端末から削除"
          }
        }
      }
    },
    "Delete Set": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットを削除"
          }
        }
      }
    },
    "Delete This Set": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセットを削除"
          }
        }
      }
    },
    "Delete this shared set? The folder is removed from the shared area, so people you share with will no longer see these photos. Copies they already saved cannot be removed. Originals and backups are kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この共有セットを削除しますか？共有エリアからフォルダが削除され、共有相手はこれらの写真を見られなくなります。相手が既に保存したコピーは削除できません。原本とバックアップは残ります。"
          }
        }
      }
    },
    "Deleted %d photo(s), skipped %d.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 枚を削除、%d 枚をスキップしました。"
          }
        }
      }
    },
    "Deleting…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除中…"
          }
        }
      }
    },
    "Deletion asks for system confirmation and can be undone from Recently Deleted for 30 days.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除時はシステムの確認ダイアログが表示され、30 日間は「最近削除した項目」から戻せます。"
          }
        }
      }
    },
    "Deletion is disabled. Enable it in Developer Options to delete for real.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実削除は無効です。実際に削除するには Developer Options で有効にしてください。"
          }
        }
      }
    },
    "Destination": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先"
          }
        }
      }
    },
    "Device photos can be shared only after they are backed up. Turn on Backup in Settings to share them (cloud photos are shared without backup).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の写真はバックアップ済みのものだけ共有できます。共有するには設定でバックアップを有効にしてください（クラウド写真はバックアップ不要で共有されます）。"
          }
        }
      }
    },
    "Don't offload": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフロードしない"
          }
        }
      }
    },
    "Dropbox Folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropbox フォルダー"
          }
        }
      }
    },
    "Dropbox is not connected. Connect from Settings → Dropbox.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropbox に未接続です。設定 → Dropbox から接続してください。"
          }
        }
      }
    },
    "Dropbox と照合（記録を検証）": {
      "comment": "A button to reconcile Dropbox and DropboxBackupMetadata.",
      "isCommentAutoGenerated": true
    },
    "Failed — will retry": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗 — 再試行します"
          }
        }
      }
    },
    "Folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダー"
          }
        }
      }
    },
    "Folders Shared with You": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されたフォルダ（受け取り側）"
          }
        }
      }
    },
    "Folders others shared with you. Their photos appear in Cloud/All Photos, and shared AI analysis (tags, search, faces) is imported automatically so this device does not re-analyze them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されたフォルダです。写真はクラウド/すべての写真に表示され、共有された AI 解析（タグ・検索・顔）は自動で取り込まれるため、この端末での再解析は不要です。"
          }
        }
      }
    },
    "Import Shared Analysis Now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された解析を今すぐ取り込む"
          }
        }
      }
    },
    "Importing…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込み中…"
          }
        }
      }
    },
    "Last result": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の結果"
          }
        }
      }
    },
    "Last synced": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終反映"
          }
        }
      }
    },
    "Loading photo library…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリを読み込み中…"
          }
        }
      }
    },
    "Maximum number of photos uploaded in a single backup run.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回のバックアップでアップロードする写真の最大数。"
          }
        }
      }
    },
    "No backup": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップしない"
          }
        }
      }
    },
    "No photos passed verification.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証に合格した写真はありません。"
          }
        }
      }
    },
    "No shared sets yet. Open an album and choose “Cloud Share…” to create one.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有セットはまだありません。アルバムを開いて「クラウド共有…」から作成してください。"
          }
        }
      }
    },
    "Not connected to Dropbox.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropbox に接続されていません。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        }
      }
    },
    "Offload": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフロード"
          }
        }
      }
    },
    "Offload (free up device storage)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフロード（端末の空き容量を増やす）"
          }
        }
      }
    },
    "Offload removes photos from this device after verifying that an identical copy exists in Dropbox (content hash match). Deleted photos remain in Recently Deleted for 30 days.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフロードは、同一の内容（content hash 一致）が Dropbox に実在することを検証してから、この端末の写真を削除します。削除した写真は 30 日間「最近削除した項目」に残ります。"
          }
        }
      }
    },
    "On": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        }
      }
    },
    "Per run": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回あたり"
          }
        }
      }
    },
    "Photos per run": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回あたりの枚数"
          }
        }
      }
    },
    "Photos will be backed up to this folder in your Dropbox. The folder will be created if it doesn't exist.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は Dropbox のこのフォルダーにバックアップされます。フォルダーが無ければ作成されます。"
          }
        }
      }
    },
    "Preview which backed-up photos could be safely removed from this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ済みの写真のうち、安全に端末から削除できるものを確認できます。"
          }
        }
      }
    },
    "Provide": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供する"
          }
        }
      }
    },
    "Reading albums and people…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムと人物を読み込み中…"
          }
        }
      }
    },
    "Ready to offload (verified)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフロード可能（検証済み）"
          }
        }
      }
    },
    "Receive": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受ける"
          }
        }
      }
    },
    "Receive Shared Albums": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有アルバムを受け取る"
          }
        }
      }
    },
    "Requesting photo library access…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリへのアクセスを要求中…"
          }
        }
      }
    },
    "Saving metadata…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータを保存中…"
          }
        }
      }
    },
    "Selected photos are copied into the shared folder. Originals and backups are never touched.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ写真は共有フォルダへコピーされます。原本とバックアップには一切触れません。"
          }
        }
      }
    },
    "Sets also sync automatically after each backup. Copies are made on the Dropbox server, so no photo data is re-uploaded.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットはバックアップ完了後にも自動で反映されます。コピーは Dropbox サーバー上で行われるため、写真データの再アップロードは発生しません。"
          }
        }
      }
    },
    "Share Your Photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の写真を共有する"
          }
        }
      }
    },
    "Share this folder with others in the Dropbox app (inviting them as view-only is recommended). Sets are created inside it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダを Dropbox アプリで共有相手に共有してください（閲覧のみでの招待を推奨）。セットはこの中に作成されます。"
          }
        }
      }
    },
    "Shared": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有済み"
          }
        }
      }
    },
    "Shared Folder (yours)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダ（自分）"
          }
        }
      }
    },
    "Shared Set": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有セット"
          }
        }
      }
    },
    "Shared Sets": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有セット"
          }
        }
      }
    },
    "Shared folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダ"
          }
        }
      }
    },
    "Skipped (kept on device)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップ（端末に保持）"
          }
        }
      }
    },
    "Some photos are not backed up yet. They are prioritized in the next backup and will be shared right after.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだバックアップされていない写真があります。次回のバックアップで優先的に処理され、完了しだい共有されます。"
          }
        }
      }
    },
    "Swipe to remove a photo from this set (the copy in the shared folder is deleted; the original is kept).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプでこのセットから写真を外せます（共有フォルダのコピーは削除・原本は残ります）。"
          }
        }
      }
    },
    "Sync Now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ反映"
          }
        }
      }
    },
    "Syncing…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反映中…"
          }
        }
      }
    },
    "This set has an invalid folder name.": {
