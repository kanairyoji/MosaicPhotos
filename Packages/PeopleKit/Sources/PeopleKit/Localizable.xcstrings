          "stringUnit": {
            "state": "translated",
            "value": "次を探す"
          }
        }
      }
    },
    "Finding faces to review…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認する顔を探しています…"
          }
        }
      }
    },
    "Finding similar people…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "似た人を探しています…"
          }
        }
      }
