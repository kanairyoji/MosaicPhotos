            "value": "写真を読み込んでいます…"
          }
        }
      }
    },
    "Manage Faces": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔の管理"
          }
        }
      }
    },
    "Members": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバー"
          }
        }
      }
    },
    "Merge %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件をまとめる"
          }
        }
      }
    },
    "Merged %lld entries.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件をまとめました。"
          }
        }
      }
    },
    "Merging…": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まとめています…"
          }
        }
      }
    },
    "Moves this photo’s face to the person you choose. The app learns from this, so the same face goes to that person next time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真の顔を、選んだ人物へ移します。この修正は学習され、次からは同じ顔がその人物に入ります。"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前"
          }
        }
      }
    },
    "Needed to be the same person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
