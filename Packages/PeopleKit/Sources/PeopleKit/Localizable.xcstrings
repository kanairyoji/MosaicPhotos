          }
        }
      }
    },
    "Kept as you left it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの指定どおり保たれる"
          }
        }
      }
    },
    "Loading faces…": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
