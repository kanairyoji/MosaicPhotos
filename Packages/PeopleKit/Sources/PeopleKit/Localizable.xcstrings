    "Not alike enough": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "似ている度が足りない"
          }
        }
      }
    },
    "Not chosen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし"
          }
        }
      }
    },
    "Not this person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の人"
          }
        }
      }
    },
    "Not this person (don’t pick anyone)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人ではない（相手を選ばない）"
          }
        }
      }
    },
    "Not “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は「%@」ではない"
          }
        }
      }
    },
    "Nothing left to merge right now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまはまとめられるものはありません。"
          }
        }
      }
    },
    "Nothing to review right now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま確認するものはありません。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Or choose the correct person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または正しい人物を選ぶ"
          }
        }
      }
    },
    "People": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピープル"
          }
        }
      }
    },
    "People in your library": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録されている人物"
          }
        }
      }
    },
    "People who look alike": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "似ている人"
          }
        }
      }
    },
    "Person options": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物の操作"
          }
        }
      }
    },
    "Photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真"
          }
        }
      }
    },
    "Photos that may be someone else": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の人かもしれない写真"
          }
        }
      }
    },
    "Photos where both appear": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方が写っている写真"
          }
        }
      }
    },
    "Remove the “%@” face": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の顔を外す"
          }
        }
      }
    },
    "Removes this face from the person. It becomes its own new person; the app learns from this so the mistake isn’t repeated.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この顔を人物から外します。新しい人物になり、以後は同じ誤りを繰り返さないよう学習します。"
          }
        }
      }
    },
    "Rename": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を変更"
          }
        }
      }
    },
    "Rename Person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を変更"
          }
        }
      }
    },
    "Review People": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人物を確認"
          }
        }
      }
    },
    "Same": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ人"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Search people": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人物を検索"
          }
        }
      }
    },
    "Select all": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて選ぶ"
          }
        }
      }
    },
    "Separate": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分離"
          }
        }
      }
    },
    "Separate %lld groups": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のグループを分離"
          }
        }
      }
    },
    "Separate %lld groups into new people?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のグループを別の人物に分離しますか？"
          }
        }
      }
    },
    "Separate Grouped Person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "束ねを解除"
          }
        }
      }
    },
    "Show face only": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔だけ表示"
          }
        }
      }
    },
    "Show people with at least": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピープルに載せる最小枚数"
          }
        }
      }
    },
    "Show whole photo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真全体を表示"
          }
        }
      }
    },
    "Skip": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップ"
          }
        }
      }
    },
    "Someone Else": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の人を選ぶ"
          }
        }
      }
    },
    "Someone Else…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人は別の人…"
          }
        }
      }
    },
    "Still scanning photos — more will appear as it progresses.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をスキャン中です。進むにつれて増えていきます。"
          }
        }
      }
    },
    "Stop Cloud Sharing…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド共有を停止…"
          }
        }
      }
    },
    "Tap a face that isn’t this person. Choose “Not this person” to just remove it, or pick the correct person.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人ではない顔をタップしてください。「この人ではない」を選ぶと相手を選ばず外せます。正しい人物を選んでもかまいません。"
          }
        }
      }
    },
    "Tap a row to see that person’s faces. Swipe left or long-press to combine them into the person you are inspecting.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行をタップするとその人物の顔が出ます。左スワイプまたは長押しで、調べている人物に一緒にできます。"
          }
        }
      }
    },
    "Tap the ones that are the same person.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ人物の写真をタップして選んでください。"
          }
        }
      }
    },
    "Thanks! %lld answers recorded.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。%lld 件の回答を記録しました。"
          }
        }
      }
    },
    "The app applies what it learned during the next overnight analysis.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習した内容は次の夜間解析で反映されます。"
          }
        }
      }
    },
    "The same person may be split into several entries.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ人物が複数に分かれていることがあります。"
          }
        }
      }
    },
    "These come from your own corrections. The more you fix, the better they fit your photos.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの修正から決まります。直すほど、あなたの写真に合った判定になります。"
          }
        }
      }
    },
    "These faces look least like the rest of this person. Orange means the app would not put this face here today. Tap one to move it to the right person.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物の中で、ほかの顔といちばん似ていない顔です。オレンジは「いまなら一緒にしない」顔です。タップすると正しい人物へ移せます。"
          }
        }
      }
    },
    "These people have different names": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別々の名前が付いています"
          }
        }
      }
    },
    "These photos contain a face of “%@” and a face of this person, so they can’t be the same person. If the same face was picked up twice, remove one of them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの写真には「%@」の顔とこの人物の顔が両方あります。同じ顔を二重に拾っている場合は、片方を外すと一緒にできます。"
          }
        }
      }
    },
    "This is “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物は「%@」"
          }
        }
      }
    },
    "This is “%@” — combine": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物は「%@」（一緒にする）"
          }
        }
      }
    },
    "This person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物"
          }
        }
      }
    },
    "This person has no name and no confirmed face, so the app may reorganize these photos on its own. Give them a name, choose a cover photo, or confirm a face to keep them as they are.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物には名前も確認済みの顔もないため、写真の並びがひとりでに変わることがあります。名前を付ける・代表写真を選ぶ・顔を確認する のどれかをすると、そのまま保たれます。"
          }
        }
      }
    },
    "Too close to another person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の人と紛らわしい"
          }
        }
      }
    },
    "Too few photos to be sure": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の写真が少なく判断できない"
          }
        }
      }
    },
    "Top: combine this person into “%@”. Bottom: switch the inspection to this person.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上: この人物を「%@」に一緒にします。下: 調べる対象をこの人物に切り替えます。"
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻す"
          }
        }
      }
    },
    "When you say “not this person”, the app remembers that face and keeps it out. Your corrections also decide how strict the matching is.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「この人ではない」と外すと、その顔を覚えて入らないようにします。修正は判定の厳しさにも反映されます。"
          }
        }
      }
    },
    "Which of these are the same person as above?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の人物と同じ人はどれですか？"
          }
        }
      }
    },
    "Which of these are “%@”?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はどれですか？"
          }
        }
      }
    },
    "Would be put together": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒にできる"
          }
        }
      }
    },
    "Yes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい"
          }
        }
      }
    },
    "You said they are different": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが「別人」と直した"
          }
        }
      }
    },
    "Your answers teach the app — recognition improves as you review.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答はアプリの学習に使われます。確認するほど認識が良くなります。"
          }
        }
      }
    },
    "confirmed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済み"
          }
        }
      }
    },
    "default %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定 %@"
          }
        }
      }
    },
    "needs %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要 %@"
          }
        }
      }
    },
    "this person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物"
          }
        }
      }
    },
    "“%@” and “%@” will be shown as the same person. You can separate them later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」と「%@」は同じ人物として表示されます。後で解除できます。"
          }
        }
      }
    },
    "・%lld photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "・%lld 枚"
          }
        }
      }
    }
  },
  "version": "1.1"
}
